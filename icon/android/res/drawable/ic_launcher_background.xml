<?xml version="1.0" encoding="utf-8"?>
<!-- Adaptive-icon background layer: diagonal gradient matched to the original
     squircle artwork (light top-left -> deeper bottom-right). Full-bleed across
     the 108dp adaptive canvas; launcher masks define the final shape. -->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:aapt="http://schemas.android.com/aapt"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="108"
    android:viewportHeight="108">
    <path android:pathData="M0,0h108v108h-108z">
        <aapt:attr name="android:fillColor">
            <gradient
                android:type="linear"
                android:startX="0" android:startY="0"
                android:endX="108" android:endY="108"
                android:startColor="#FFDDF2FB"
                android:endColor="#FF95CDF9" />
        </aapt:attr>
    </path>
</vector>
